{
  "manifest_version": 3,
  "name": "Fatura Boa",
  "version": "0.2.1",
  "description": "O teu e-Fatura, organizado. Análise e classificação das faturas, 100% no teu navegador - nada sai dele.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["scripting"],
  "host_permissions": ["https://*.portaldasfinancas.gov.pt/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.portaldasfinancas.gov.pt/*"],
      "js": ["bar.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Fatura Boa - abre o e-Fatura para usar" }
}
