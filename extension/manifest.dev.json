{
  "manifest_version": 3,
  "name": "Fatura Boa DEV",
  "version": "0.7.0.2",
  "version_name": "0.7.0-dev.2",
  "description": "Versão de desenvolvimento da Fatura Boa, instalada separadamente para testar o painel de faturas.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://faturas.portaldasfinancas.gov.pt/*",
    "https://imoveis.portaldasfinancas.gov.pt/*",
    "https://sitfiscal.portaldasfinancas.gov.pt/*",
    "https://irs.portaldasfinancas.gov.pt/*",
    "https://www.seg-social.pt/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://faturas.portaldasfinancas.gov.pt/*",
        "https://imoveis.portaldasfinancas.gov.pt/*",
        "https://sitfiscal.portaldasfinancas.gov.pt/*",
        "https://irs.portaldasfinancas.gov.pt/*",
        "https://www.seg-social.pt/*"
      ],
      "js": ["config.js", "bar.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["offers.json"],
      "matches": [
        "https://faturas.portaldasfinancas.gov.pt/*",
        "https://imoveis.portaldasfinancas.gov.pt/*",
        "https://sitfiscal.portaldasfinancas.gov.pt/*",
        "https://irs.portaldasfinancas.gov.pt/*",
        "https://www.seg-social.pt/*"
      ]
    }
  ],
  "action": { "default_title": "Fatura Boa DEV - mostrar novamente a barra" }
}
